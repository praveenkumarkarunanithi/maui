<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Chat bubble styling -->
    <Style x:Key="ChatBubbleFrame" TargetType="Grid">
        <Setter Property="Padding" Value="12" />
      
    </Style>

    <!-- User message bubble (right-aligned, light blue) -->
    <Style x:Key="UserBubbleFrame" TargetType="Grid" BasedOn="{StaticResource ChatBubbleFrame}">
        <Setter Property="BackgroundColor" Value="#E3F2FD" />
        <Setter Property="HorizontalOptions" Value="End" />
    </Style>

    <!-- Bot message bubble (left-aligned, light gray) -->
    <Style x:Key="BotBubbleFrame" TargetType="Grid" BasedOn="{StaticResource ChatBubbleFrame}">
        <Setter Property="BackgroundColor" Value="#F5F5F5" />
        <Setter Property="HorizontalOptions" Value="Start" />
    </Style>

    <!-- WebView styling for chat content -->
    <Style x:Key="ChatWebView" TargetType="WebView">
        <Setter Property="VerticalOptions" Value="Fill" />
        <Setter Property="HorizontalOptions" Value="Fill" />
    </Style>

    <!-- Chat container grid spacing -->
    <Style x:Key="ChatContainer" TargetType="StackLayout">
        <Setter Property="Spacing" Value="8" />
        <Setter Property="Padding" Value="12" />
    </Style>

</ResourceDictionary>
